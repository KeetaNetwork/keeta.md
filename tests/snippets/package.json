{
  "name": "keeta-md-snippets",
  "private": true,
  "type": "module",
  "description": "Typechecks every TypeScript block in the Keeta skills against the published SDKs named in README.md.",
  "scripts": {
    "extract": "python3 ../../.github/scripts/extract-snippets.py",
    "typecheck": "npm run extract && tsc -p tsconfig.json",
    "live": "npm run extract && node live.mjs"
  },
  "dependencies": {
    "@keetanetwork/anchor": "0.0.104",
    "@keetanetwork/keetanet-client": "0.18.8",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/keeta": "2.28.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3",
    "@types/express": "5.0.3",
    "tsx": "4.20.6"
  },
  "overrides": {
    "@keetanetwork/anchor": "$@keetanetwork/anchor",
    "@keetanetwork/keetanet-client": "$@keetanetwork/keetanet-client"
  }
}
